# =============================================================
# CPF — Club de Plongée Fleurusien
# Variables d'environnement
# =============================================================
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer .env dans git.
# =============================================================

# ---------------------------------------------------------------
# Supabase — Projet (https://app.supabase.com → Settings → API)
# ---------------------------------------------------------------

# URL du projet Supabase
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anon (safe to use in client)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL de base des Edge Functions (sans slash final)
# Format : https://your-project-id.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=https://your-project-id.supabase.co/functions/v1

# ---------------------------------------------------------------
# Développement local avec Supabase CLI
# ---------------------------------------------------------------
# Après `supabase start`, les valeurs locales sont affichées.
# Typiquement :
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#   VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
#
# La SERVICE_ROLE_KEY est utilisée UNIQUEMENT par les Edge Functions
# côté serveur (jamais exposée au client). Elle est injectée
# automatiquement dans le runtime Deno des Edge Functions.
# Pour usage local : supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
